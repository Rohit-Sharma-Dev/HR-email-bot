# Google Sheets Configuration
GOOGLE_SHEET_ID=1abcXYZ_your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "..."}

# Email Service Type: "gmail_api" (default) or "nodemailer"
EMAIL_SERVICE_TYPE=gmail_api

# Gmail API Credentials (OAuth2)
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your_oauth_client_secret
GMAIL_REFRESH_TOKEN=1//04_your_refresh_token
SENDER_EMAIL=your_email@gmail.com

# Nodemailer Credentials (Fallback)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional Custom Settings
MAX_EMAILS_PER_RUN=15
MIN_DELAY_MS=30000
MAX_DELAY_MS=90000
CONTACTS_TAB_NAME=Contacts
LOGS_TAB_NAME=Logs
